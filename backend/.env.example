# MineGuard AI — Backend Production Environment Variables
PROJECT_NAME="MineGuard AI"
PROJECT_SUBTITLE="Intelligent Mine Governance & Compliance Monitoring System"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default uses local SQLite in backend directory; or set PostgreSQL URL)
DATABASE_URL="sqlite:///mineguard.db"

# Allowed CORS Origins (comma separated list of your frontend domains)
# Example: https://mineguard-ai.vercel.app,http://localhost:5173
ALLOWED_ORIGINS="*"
